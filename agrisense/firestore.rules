rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is user an admin ───────────────────────────────────────────
    function isAdmin() {
      let adminDoc = get(/databases/$(database)/documents/config/admin);
      return adminDoc.exists && (
        request.auth.uid in adminDoc.data.uids ||
        request.auth.token.phone_number in adminDoc.data.phones
      );
    }

    // ── User profiles ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Lessons ────────────────────────────────────────────────────────────
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ── Tips ───────────────────────────────────────────────────────────────
    match /tips/{tipId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ── Config (admin list) ────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Only writable via Firebase Console
    }

    // ── Community posts ────────────────────────────────────────────────────
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500;
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());

      match /upvotes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
